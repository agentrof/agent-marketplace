{
  "schema_version": 1,
  "model_aliases": ["opus", "sonnet", "haiku", "inherit"],
  "frontmatter_actions": [
    "keep",
    "drop",
    "rename",
    "replace_when_present",
    "map_model",
    "policy_flag",
    "nest"
  ],
  "harnesses": {
    "cursor": {
      "display_name": "Cursor",
      "marketplace_path": ".cursor-plugin/marketplace.json",
      "plugin_manifest_path": ".cursor-plugin/plugin.json",
      "agents_dir": "cursor/agents",
      "agent_format": "markdown",
      "hooks_manifest": "cursor/hooks/hooks.json",
      "unsupported_events": [],
      "hook_routes": [
        {"source_event": "SessionStart", "target_event": "sessionStart", "matcher": "none"},
        {"source_event": "SessionEnd", "target_event": "sessionEnd", "matcher": "none"},
        {"source_event": "SubagentStart", "target_event": "subagentStart", "matcher": "none"},
        {"source_event": "SubagentStop", "target_event": "subagentStop", "matcher": "none"},
        {"source_event": "PreToolUse", "requires_token": "Bash", "target_event": "beforeShellExecution", "matcher": "none"},
        {"source_event": "PreToolUse", "requires_token": "Write", "target_event": "preToolUse", "matcher": "derive", "drop_tokens": ["Bash"]},
        {"source_event": "PostToolUse", "requires_token": "Write", "target_event": "postToolUse", "matcher": "derive"},
        {"source_event": "PostToolUse", "requires_token": "Write", "target_event": "afterFileEdit", "matcher": "none"}
      ],
      "token_expansions": {
        "Write": ["Write", "write", "create_file", "search_replace"],
        "Edit": ["Edit", "edit_file", "MultiEdit"],
        "Bash": ["Bash"]
      },
      "command_rewrite": {
        "policy": "env_prefix",
        "var": "CURSOR_PLUGIN_ROOT",
        "fallback": "."
      },
      "guard_command_markers": ["hook_guard_db.py", "vault_hook.py pre"],
      "guard_options": {"failClosed": true, "timeout": 30},
      "hooks_version": 1,
      "agent_frontmatter": {
        "name": {"action": "keep"},
        "description": {"action": "keep"},
        "model": {"action": "map_model"},
        "tools": {"action": "replace_when_present", "key": "readonly", "value": true}
      },
      "skill_frontmatter": {
        "name": {"action": "keep"},
        "description": {"action": "keep"},
        "disable-model-invocation": {"action": "keep"},
        "user-invocable": {"action": "drop"}
      },
      "model_map": {
        "opus": {"model": "inherit"},
        "sonnet": {"model": "inherit"},
        "haiku": {"model": "inherit"},
        "inherit": {"model": "inherit"}
      },
      "model_fallback": "inherit"
    },
    "codex": {
      "display_name": "OpenAI Codex CLI",
      "marketplace_path": ".agents/plugins/marketplace.json",
      "plugin_manifest_path": ".codex-plugin/plugin.json",
      "agents_dir": "codex/agents",
      "agent_format": "toml",
      "hooks_manifest": "codex/hooks/hooks.json",
      "unsupported_events": ["SessionEnd"],
      "hook_routes": [
        {"source_event": "SessionStart", "target_event": "SessionStart", "matcher": "none"},
        {"source_event": "SubagentStart", "target_event": "SubagentStart", "matcher": "none"},
        {"source_event": "SubagentStop", "target_event": "SubagentStop", "matcher": "none"},
        {"source_event": "PreToolUse", "target_event": "PreToolUse", "matcher": "derive"},
        {"source_event": "PostToolUse", "target_event": "PostToolUse", "matcher": "derive"}
      ],
      "token_expansions": {
        "Write": ["Write", "apply_patch"],
        "Edit": ["Edit"],
        "Bash": ["Bash"]
      },
      "command_rewrite": {"policy": "keep_verbatim"},
      "guard_command_markers": [],
      "guard_options": {},
      "skill_policy_file": "agents/openai.yaml",
      "agent_frontmatter": {
        "name": {"action": "keep"},
        "description": {"action": "keep"},
        "model": {"action": "map_model"},
        "tools": {"action": "replace_when_present", "key": "sandbox_mode", "value": "read-only"}
      },
      "skill_frontmatter": {
        "name": {"action": "keep"},
        "description": {"action": "keep"},
        "disable-model-invocation": {"action": "policy_flag", "policy_key": "allow_implicit_invocation", "when_true": false, "when_false": true},
        "user-invocable": {"action": "drop"}
      },
      "model_map": {
        "opus": {},
        "sonnet": {},
        "haiku": {},
        "inherit": {}
      },
      "model_fallback": "inherit"
    }
  },
  "runtime": {
    "schema_version": 1,
    "path": "plugins/project-management-office/scripts/harness_runtime.json",
    "harness_signals": {
      "claude_code": {"env": "CLAUDE_PLUGIN_ROOT", "stdin_field": ""},
      "cursor": {"env": "CURSOR_PLUGIN_ROOT", "stdin_field": "cursor_version"},
      "codex": {"env": "PLUGIN_ROOT", "stdin_field": ""}
    },
    "install_roots": {
      "claude_code": {"registry": "~/.claude/plugins/installed_plugins.json", "globs": [], "pick": "registry"},
      "cursor": {"registry": "", "globs": [], "pick": "hook_only"},
      "codex": {"registry": "", "globs": ["~/.codex/plugins/cache/*/{plugin}/*"], "pick": "newest_version"}
    },
    "sandbox_stanzas": {
      "cursor": {
        "file": "~/.cursor/sandbox.json",
        "stanza": "{\"additionalReadwritePaths\": [\"{home}/.agentrof\"]}",
        "note": "Merge into the existing file when one exists; the sandbox denies writes outside the workspace by default."
      },
      "codex": {
        "file": "~/.codex/config.toml",
        "stanza": "[sandbox_workspace_write]\nwritable_roots = [\"{home}/.agentrof\", \"{home}/.codex/agents\"]",
        "note": "Without this, every write outside the workspace escalates for approval per attempt."
      }
    },
    "restart_after_setup": {"claude_code": false, "cursor": false, "codex": true}
  },
  "docs": {
    "matrix_rows": [
      {"capability": "Install channel", "claude_code": "plugin marketplace add, plugin install", "cursor": "team marketplace import from the repository, or local plugin symlink; marketplace publication planned", "codex": "codex plugin marketplace add, then the plugins browser"},
      {"capability": "Skills", "claude_code": "native source tree", "cursor": "native source tree (Agent Skills standard)", "codex": "native source tree via the plugin skills pointer"},
      {"capability": "Agents", "claude_code": "native source tree", "cursor": "generated markdown tree, model inherit, readonly for restricted roles", "codex": "generated TOML tree synced into the personal agents directory by setup"},
      {"capability": "Entry-skill encapsulation", "claude_code": "disable-model-invocation", "cursor": "disable-model-invocation honored", "codex": "openai.yaml allow_implicit_invocation false"},
      {"capability": "Knowledge-skill hiding", "claude_code": "user-invocable false", "cursor": "not supported; skills appear in the menu", "codex": "not supported; skills appear in the menu"},
      {"capability": "Hooks", "claude_code": "native, deny before write", "cursor": "generated manifest, camelCase events, failClosed guards, deny before write", "codex": "generated manifest; guardrail coverage only (shell, patch, MCP); user must trust via the hooks review"},
      {"capability": "Session end accounting", "claude_code": "SessionEnd hook", "cursor": "sessionEnd hook", "codex": "absent; reconciled at the next session start"},
      {"capability": "Enforcement without hooks", "claude_code": "not applicable", "cursor": "detect-after mode: integrity tripwire plus gate checks", "codex": "detect-after mode: integrity tripwire plus gate checks"},
      {"capability": "Dashboard", "claude_code": "launched by the control-tower entry", "cursor": "hand-launched in the user's terminal (sandbox blocks local binding)", "codex": "hand-launched in the user's terminal (sandbox blocks local binding)"},
      {"capability": "Model policy", "claude_code": "alias enum in agent frontmatter", "cursor": "all aliases resolve to inherit; the session model governs", "codex": "all aliases resolve to inherit; the session model governs"},
      {"capability": "Windows", "claude_code": "supported", "cursor": "out of scope (POSIX shell commands)", "codex": "out of scope (POSIX shell commands)"}
    ]
  }
}
