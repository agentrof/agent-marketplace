    {
      "id": "test-plan",
      "query": "tag:#doc/test-plan",
      "rgb": 2278750
    },
    {
      "id": "issue-report",
      "query": "tag:#doc/issue-report",
      "rgb": 14513808
    }
  ],
  "hubs": [
    {
      "note": "business-analysis/*/space.md",
      "covers": "business-analysis/*"
    },
    {
      "note": "business-analysis/*/domains/*/domain.md",
      "covers": "business-analysis/*/domains/*"
    },
    {
      "note": "business-analysis/*/domains/*/domains/*/domain.md",
      "covers": "business-analysis/*/domains/*/domains/*"
    }
  ],
  "tag_namespaces": [
    "doc",
    "status"
  ],
  "nav_peer_min": 0,
  "nav_peer_max": 5,
  "generated_marker_prefix": "<!-- generated by",
  "decision_trees": {
    "solution_design": {
      "path": "solution-design/decisions",
      "id_prefix": "SD",
      "id_min_width": 3,
      "render_index": true,
      "extra_column": "territory",
      "id_source": "alias"
    },
    "system_architecture": {
      "path": "system-architecture/decisions",
      "id_prefix": "ADR",
      "id_min_width": 3,
      "render_index": true,
      "extra_column": "story",
      "id_source": "alias"
    },
    "ba_space": {
      "path": "business-analysis/*/decisions",
      "id_prefix": "DEC",
      "id_min_width": 3,
      "render_index": false,
      "id_source": "alias"
    },
    "ba_domain": {
      "path": "business-analysis/*/domains/*/decisions",
      "id_prefix": "DEC",
      "id_min_width": 3,
      "render_index": false,
      "id_source": "alias"
    },
    "ba_domain_nested": {
      "path": "business-analysis/*/domains/*/domains/*/decisions",
      "id_prefix": "DEC",
      "id_min_width": 3,
      "render_index": false,
      "id_source": "alias"
    }
  },
  "generated_views": [
    "solution-design/decision-log.md",
    "system-architecture/decision-log.md"
  ],
  "generated_subtrees": [
    "api/"
  ],
  "attachments_dir": "_attachments",
  "attachment_extensions": [
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".pdf",
    ".mp3", ".wav", ".m4a", ".mp4", ".webm"
  ],
  "property_types": {
    "type": "text",
    "title": "text",
    "status": "text",
    "owner_role": "text",
    "issue_kind": "text",
    "external_url": "text",
    "filed_at_utc": "datetime",
