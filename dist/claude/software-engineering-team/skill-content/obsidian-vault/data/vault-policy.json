    {
      "id": "navigation",
      "query": "tag:#doc/moc OR tag:#doc/home",
      "rgb": 9741240
    },
    {
      "id": "backlog",
      "query": "tag:#doc/backlog",
      "rgb": 11032055
    },
    {
      "id": "backlog-review",
      "query": "tag:#doc/backlog-review",
      "rgb": 16007006
    },
    {
      "id": "epic",
      "query": "tag:#doc/epic",
      "rgb": 3900150
    },
    {
      "id": "epic-review",
      "query": "tag:#doc/epic-review",
      "rgb": 16096779
    },
    {
      "id": "story",
      "query": "tag:#doc/story",
      "rgb": 1357990
