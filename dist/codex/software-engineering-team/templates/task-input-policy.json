      ],
      "roles": [
        "product-owner",
        "backlog-reviewer",
        "business-analyst",
        "qa-engineer"
      ],
      "scope_kind": "backlog",
      "project_state": true,
      "write_scope": {
        "resolver": "backlog_documents",
        "roles": [
          "product-owner"
        ]
      },
      "next_transition": "The Product Owner persists contributions only after every reviewer finishes; backlog_compile.py must validate the selected reviews and approve the exact backlog revision before committed handoff."
