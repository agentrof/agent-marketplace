{
  "schema_version": 5,
  "vault_root_dirname": "docs",
  "home_file": "home.md",
  "maps_dir": "maps",
  "subtrees": [
    "business-analysis",
    "solution-design",
    "system-architecture",
    "design-system",
    "experience-design",
    "backlog",
    "issues"
  ],
  "extra_maps": [],
  "machine_dirs": [
    "_generated",
    "_relations",
    "_navigation"
  ],
  "banned_basenames": [
    "index.md",
    "notes.md",
    "overview.md",
    "readme.md",
    "registry.md",
    "status.md"
  ],
  "community_plugins": [
    "obsidian-front-matter-title-plugin"
  ],
  "graph_search": "-path:_generated",
  "graph_color_groups": [
    {
      "id": "space",
