    },
    {
      "id": "journey",
      "query": "tag:#doc/journey OR tag:#doc/flow-set",
      "rgb": 16747520
    },
    {
      "id": "screen",
      "query": "tag:#doc/screen OR tag:#doc/artifact-manifest",
      "rgb": 5592575
