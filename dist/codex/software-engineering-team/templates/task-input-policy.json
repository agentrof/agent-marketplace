        "resolver": "item_claims",
        "roles": [
          "software-architect",
          "backend-developer",
          "frontend-developer",
          "devops-engineer"
        ]
      },
      "next_transition": "Implementation requires the approved Item plan and active writer receipt. Review and QA require the same frozen candidate; delivery_verification.py controls reader barriers and final evidence, and Delivery Git validates integration."
    },
    "configure": {
      "flows": [
        "operation",
        "delivery-governance"
      ],
      "roles": [
        "delivery-coordinator",
        "qa-engineer",
        "devops-engineer"
      ],
      "scope_kind": "operation",
      "project_state": true,
      "write_scope": {
        "resolver": "unresolved",
        "roles": []
      },
      "next_transition": "The selected Operation or Governance compiler must validate and approve the exact changed contract; publication and slot transitions retain their existing gates."
