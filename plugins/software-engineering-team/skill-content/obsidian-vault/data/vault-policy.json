{
  "schema_version": 3,
  "vault_root_dirname": "docs",
  "home_file": "home.md",
  "maps_dir": "maps",
  "subtrees": [
    "business-analysis",
    "solution-design",
    "system-architecture",
    "design-system"
  ],
  "extra_maps": [],
  "machine_dirs": [
    "_generated"
  ],
  "banned_basenames": [
    "index.md",
    "notes.md",
    "overview.md",
    "readme.md",
    "registry.md",
    "status.md"
  ],
  "community_plugins": [
    "obsidian-front-matter-title-plugin"
  ],
  "graph_search": "-path:_generated",
  "graph_color_groups": [
    {
      "id": "space",
      "query": "tag:#doc/space",
      "rgb": 16733986
    },
    {
      "id": "domain",
      "query": "tag:#doc/domain",
      "rgb": 16752640
    },
    {
      "id": "glossary",
      "query": "tag:#doc/glossary",
      "rgb": 16498733
    },
    {
      "id": "actor-roster",
      "query": "tag:#doc/actor-roster",
      "rgb": 9268835
    },
    {
      "id": "budget-set",
      "query": "tag:#doc/budget-set",
      "rgb": 15483002
    },
    {
      "id": "entity",
      "query": "tag:#doc/entity",
      "rgb": 2201331
    },
    {
      "id": "process",
      "query": "tag:#doc/process",
      "rgb": 48340
    },
    {
      "id": "rule-set",
      "query": "tag:#doc/rule-set",
      "rgb": 4149685
    },
    {
      "id": "acceptance-set",
      "query": "tag:#doc/acceptance-set",
      "rgb": 5431378
    },
    {
      "id": "decision",
      "query": "tag:#doc/decision",
      "rgb": 10233776
    },
    {
      "id": "integration",
      "query": "tag:#doc/integration",
      "rgb": 38536
    },
    {
      "id": "challenge-record",
      "query": "tag:#doc/challenge-record",
      "rgb": 10394916
    },
    {
      "id": "landscape",
      "query": "tag:#doc/landscape",
      "rgb": 5227511
    },
    {
      "id": "engagement",
      "query": "tag:#doc/engagement",
      "rgb": 8280002
    },
    {
      "id": "design-master",
      "query": "tag:#doc/design-master",
      "rgb": 11342935
    },
    {
      "id": "page-override",
      "query": "tag:#doc/page-override",
      "rgb": 13538264
    },
    {
      "id": "navigation",
      "query": "tag:#doc/moc OR tag:#doc/home",
      "rgb": 9741240
    }
  ],
  "hubs": [
    {
      "note": "business-analysis/*/space.md",
      "covers": "business-analysis/*"
    },
    {
      "note": "business-analysis/*/domains/*/domain.md",
      "covers": "business-analysis/*/domains/*"
    },
    {
      "note": "business-analysis/*/domains/*/domains/*/domain.md",
      "covers": "business-analysis/*/domains/*/domains/*"
    }
  ],
  "tag_namespaces": [
    "doc",
    "status"
  ],
  "nav_peer_min": 2,
  "nav_peer_max": 5,
  "generated_marker_prefix": "<!-- generated by",
  "decision_trees": {
    "solution_design": {
      "path": "solution-design/decisions",
      "id_prefix": "SD",
      "id_min_width": 3,
      "render_index": true,
      "extra_column": "territory",
      "id_source": "alias"
    },
    "system_architecture": {
      "path": "system-architecture/decisions",
      "id_prefix": "ADR",
      "id_min_width": 3,
      "render_index": true,
      "extra_column": "story",
      "id_source": "alias"
    },
    "ba_space": {
      "path": "business-analysis/*/decisions",
      "id_prefix": "DEC",
      "id_min_width": 3,
      "render_index": false,
      "id_source": "alias"
    },
    "ba_domain": {
      "path": "business-analysis/*/domains/*/decisions",
      "id_prefix": "DEC",
      "id_min_width": 3,
      "render_index": false,
      "id_source": "alias"
    },
    "ba_domain_nested": {
      "path": "business-analysis/*/domains/*/domains/*/decisions",
      "id_prefix": "DEC",
      "id_min_width": 3,
      "render_index": false,
      "id_source": "alias"
    }
  },
  "generated_views": [
    "solution-design/decision-log.md",
    "system-architecture/decision-log.md"
  ],
  "generated_subtrees": [
    "api/"
  ],
  "attachments_dir": "_attachments",
  "property_types": {
    "type": "text",
    "title": "text",
    "status": "text",
    "owner_role": "text",
    "approved_at": "date",
    "decided_at": "date",
    "superseded_by": "text",
    "supersedes": "text",
    "engagement": "text",
    "territory": "text",
    "revisit_trigger": "text",
    "story": "text",
    "governs": "list",
    "verifies": "list",
    "code": "text",
    "scope": "text",
    "review_scope": "text",
    "verdict": "text",
    "system_name": "text",
    "direction": "text",
    "round": "number",
    "locked": "checkbox",
    "tags": "list",
    "aliases": "list"
  },
  "extra_doc_types": [
    "moc",
    "home",
    "landscape",
    "engagement",
    "design-master",
    "page-override"
  ]
}
