{
  "schema_version": 1,
  "description": "Impact groups are conservative dependency closures. Unmapped/shared inputs run the complete suite. Every lane runs the one supported `python` version, its shards as separate jobs and each shard in `workers` processes. Measured per-test reports weigh the partition; test_seconds keeps, per runner operating system, the tests that took at least five seconds (refresh it with `tools/ci_tests.py estimates`) for a plan whose policy changed, and every other test weighs default_seconds.",
  "default_seconds": 1.0,
  "python": "3.14",
  "module_seconds": {},
  "always_groups": [
    "contracts"
  ],
  "generated_paths": [
    "dist/*"
  ],
  "generated_sources": [
    "plugins/*",
    "platforms/*",
    "product.json",
    "package-modes.json",
    "versions.json",
    "tools/build_distributions.py"
  ],
  "full_paths": [
    ".github/workflows/*",
    "Makefile",
    "tools/ci_*.py",
    "tools/data/ci-*.json",
    "tools/data/*",
    "platforms/*",
    "package-modes.json",
    "product.json",
    ".gitattributes",
    ".claude-plugin/*",
    ".agents/*",
    "plugins/*/*.md",
    "plugins/*/scripts/atomic_file.py",
    "plugins/*/scripts/file_lock.py",
    "plugins/*/scripts/project_config.py",
    "plugins/*/scripts/vault_check.py",
    "plugins/*/scripts/setup*.py",
    "plugins/*/scripts/marketplace_paths.py",
    "plugins/*/templates/*",
    "plugins/*/skill-content/*",
    ".gitignore",
    "tools/tests/test_ci_*.py",
    "tools/tests/fixtures.py",
    "tools/tests/git_fixture.py",
    "tools/tests/fixture_cache.py",
    "plugins/*/scripts/task_inputs.py"
  ],
  "rules": [
    {
      "paths": [
        "README.md",
        "CHANGELOG.md",
        "AGENTS.md",
        "CLAUDE.md",
        "docs/*",
        "memory/*",
        "LICENSE"
      ],
      "groups": [
        "documentation"
      ]
    },
    {
      "paths": [
        "versions.json",
        ".release/*"
      ],
      "groups": [
        "release"
      ]
    },
    {
      "paths": [
        "dist/*"
      ],
      "groups": [
        "contracts"
      ]
    },
    {
      "paths": [
        "tools/counts.py"
      ],
      "groups": [
        "documentation"
      ]
    },
    {
      "paths": [
        "tools/model_drift.py"
      ],
      "groups": [
        "contracts"
      ]
    },
    {
      "paths": [
        "plugins/software-engineering-team/scripts/process_policy.py"
      ],
      "groups": [
        "delivery"
      ]
    },
    {
      "paths": [
        ".changes/*"
      ],
      "groups": [
        "release_metadata"
      ]
    }
  ],
