{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}\"/scripts/hook_session_start.py"}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}\"/scripts/hook_session_end.py"}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}\"/scripts/hook_subagent.py start"}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}\"/scripts/hook_subagent.py stop"}]}],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|apply_patch|Bash",
        "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}\"/scripts/hook_guard_db.py"}]
      }
    ]
  }
}
