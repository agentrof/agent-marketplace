{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/scripts/hook_session_start.py\""
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/scripts/hook_session_end.py\""
      }
    ],
    "subagentStart": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/scripts/hook_subagent.py\" start"
      }
    ],
    "subagentStop": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/scripts/hook_subagent.py\" stop"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/scripts/hook_guard_db.py\"",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/scripts/hook_guard_db.py\"",
        "matcher": "Write|write|create_file|search_replace|Edit|edit_file|MultiEdit",
        "failClosed": true,
        "timeout": 30
      }
    ]
  }
}
