{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}\"/scripts/team_guard.py register"}]}],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}\"/skill-content/autopilot/scripts/autopilot.py hook user-prompt --host codex --entry software-engineering-team:autopilot --session-env CODEX_THREAD_ID", "timeout": 10}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|apply_patch|Bash",
        "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}\"/scripts/vault_hook.py pre"}]
      },
      {
        "matcher": "^request_user_input(_async)?$",
        "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}\"/skill-content/autopilot/scripts/autopilot.py hook pre-question --host codex", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch|Bash",
        "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}\"/scripts/vault_hook.py post"}]
      }
    ]
  }
}
