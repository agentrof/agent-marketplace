{
  "schema_version": 2,
  "vault_root_dirname": "docs",
  "home_file": "home.md",
  "maps_dir": "maps",
  "subtrees": [
    "business-analysis",
    "solution-design",
    "system-architecture",
    "design-system"
  ],
  "extra_maps": [],
  "machine_dirs": [
    "_generated"
  ],
  "banned_basenames": [
    "index.md",
    "notes.md",
    "overview.md",
    "readme.md",
    "registry.md",
    "status.md"
  ],
  "community_plugins": [
    "obsidian-front-matter-title-plugin"
  ],
  "graph_search": "-path:_generated",
  "graph_color_groups": [
    "tag:#doc/space",
    "tag:#doc/domain",
    "tag:#doc/glossary",
    "tag:#doc/actor-roster",
    "tag:#doc/budget-set",
    "tag:#doc/entity",
    "tag:#doc/process",
    "tag:#doc/rule-set",
    "tag:#doc/acceptance-set",
    "tag:#doc/decision",
    "tag:#doc/integration",
    "tag:#doc/challenge-record",
    "tag:#doc/landscape",
    "tag:#doc/engagement",
    "tag:#doc/design-master",
    "tag:#doc/page-override",
    "tag:#doc/moc OR tag:#doc/home"
  ],
  "hubs": [
    {
      "note": "business-analysis/*/space.md",
      "covers": "business-analysis/*"
    },
    {
      "note": "business-analysis/*/domains/*/domain.md",
      "covers": "business-analysis/*/domains/*"
    },
    {
      "note": "business-analysis/*/domains/*/domains/*/domain.md",
      "covers": "business-analysis/*/domains/*/domains/*"
    }
  ],
  "tag_namespaces": [
    "doc",
    "status"
  ],
  "nav_peer_min": 2,
  "nav_peer_max": 5,
  "generated_marker_prefix": "<!-- generated by",
  "decision_trees": {
    "solution_design": {
      "path": "solution-design/decisions",
      "id_prefix": "SD",
      "id_min_width": 3,
      "render_index": true,
      "extra_column": "territory",
      "id_source": "alias"
    },
    "system_architecture": {
      "path": "system-architecture/decisions",
      "id_prefix": "ADR",
      "id_min_width": 3,
      "render_index": true,
      "extra_column": "story",
      "id_source": "alias"
    },
    "ba_space": {
      "path": "business-analysis/*/decisions",
      "id_prefix": "DEC",
      "id_min_width": 3,
      "render_index": false,
      "id_source": "alias"
    },
    "ba_domain": {
      "path": "business-analysis/*/domains/*/decisions",
      "id_prefix": "DEC",
      "id_min_width": 3,
      "render_index": false,
      "id_source": "alias"
    },
    "ba_domain_nested": {
      "path": "business-analysis/*/domains/*/domains/*/decisions",
      "id_prefix": "DEC",
      "id_min_width": 3,
      "render_index": false,
      "id_source": "alias"
    }
  },
  "generated_views": [
    "solution-design/decision-log.md",
    "system-architecture/decision-log.md"
  ],
  "generated_subtrees": [
    "api/"
  ],
  "attachments_dir": "_attachments",
  "property_types": {
    "type": "text",
    "title": "text",
    "status": "text",
    "owner_role": "text",
    "approved_at": "date",
    "decided_at": "date",
    "superseded_by": "text",
    "supersedes": "text",
    "engagement": "text",
    "territory": "text",
    "revisit_trigger": "text",
    "story": "text",
    "governs": "list",
    "verifies": "list",
    "code": "text",
    "scope": "text",
    "review_scope": "text",
    "verdict": "text",
    "system_name": "text",
    "direction": "text",
    "round": "number",
    "locked": "checkbox",
    "tags": "list",
    "aliases": "list"
  },
  "graph_group_colors": [
    16733986,
    16752640,
    16498733,
    9268835,
    15483002,
    2201331,
    48340,
    4149685,
    5431378,
    10233776,
    38536,
    10394916,
    5227511,
    8280002,
    11342935,
    13538264,
    9741240
  ],
  "extra_doc_types": [
    "moc",
    "home",
    "landscape",
    "engagement",
    "design-master",
    "page-override"
  ]
}
