{
  "schema_version": 2,
  "statuses": [
    "draft",
    "in_review",
    "approved",
    "superseded"
  ],
  "code_format": "^[A-Z]{2,4}$",
  "reserved_codes": [],
  "id_format": "^(BR|AC|AS|OQ|DEC|CH)-([A-Z]{2,4})-([0-9]{3,})$",
  "id_citation_columns": [
    "cites",
    "affects",
    "blocks",
    "targets",
    "verify"
  ],
  "naming": {
    "identifier_format": "^[a-z][a-z0-9_]*$",
    "identifier_columns": [
      {
        "doc_type": "entity",
        "section": "fields",
        "column": "field"
      },
      {
        "doc_type": "glossary",
        "section": "terms",
        "column": "technical_name",
        "allow_empty": true
      }
    ]
  },
  "frontmatter": {
    "required": [
      "type",
      "title",
      "status",
      "owner_role"
    ],
    "optional": [
      "approved_at",
      "superseded_by",
      "code",
      "governs",
      "verifies",
      "system_name",
      "direction",
      "scope",
      "round",
      "review_scope",
      "verdict",
      "locked",
      "tags",
      "aliases"
    ]
  },
  "summary_max_lines": {
    "space": 30,
    "default": 10
  },
  "nfr_categories": [
    "performance",
    "volume",
    "availability",
    "security",
    "compliance",
    "operability"
  ],
  "doc_types": {
    "space": {
      "location": {
        "kind": "named_file",
        "name": "space.md",
        "root_only": true
      },
      "required_sections": [
        "purpose_scope",
        "domain_map",
        "out_of_scope"
      ],
      "mints": [
        "AS",
        "OQ"
      ],
      "gate_blocking": true,
      "extra_frontmatter": {
        "required": [
          "code"
        ],
        "optional": []
      }
    },
    "domain": {
      "location": {
        "kind": "named_file",
        "name": "domain.md",
        "domain_only": true
      },
      "required_sections": [
        "mission",
        "boundaries",
        "process_map",
        "data_notes"
      ],
      "mints": [
        "AS",
        "OQ"
      ],
      "gate_blocking": true,
      "extra_frontmatter": {
        "required": [
          "code"
        ],
        "optional": []
      }
    },
    "process": {
      "location": {
        "kind": "folder",
        "folder": "processes",
        "filename_suffix": "process"
      },
      "required_sections": [
        "actors",
        "trigger",
        "main_flow",
        "exception_flows"
      ],
      "mints": [
        "AS",
        "OQ"
      ],
      "gate_blocking": true,
      "extra_frontmatter": {
        "required": [],
        "optional": []
      }
    },
    "entity": {
      "location": {
        "kind": "folder",
        "folder": "entities",
        "filename_suffix": "entity"
      },
      "required_sections": [
        "fields",
        "lifecycle",
        "propagation"
      ],
      "mints": [
        "AS",
        "OQ"
      ],
      "gate_blocking": true,
      "extra_frontmatter": {
        "required": [],
        "optional": []
      }
    },
    "rule_set": {
      "location": {
        "kind": "folder",
        "folder": "rules",
        "filename_suffix": "rules"
      },
      "required_sections": [
        "rules"
      ],
      "mints": [
        "BR",
        "AS",
        "OQ"
      ],
      "gate_blocking": true,
      "extra_frontmatter": {
        "required": [
          "governs"
        ],
        "optional": []
      }
    },
    "acceptance_set": {
      "location": {
        "kind": "folder",
        "folder": "acceptance",
        "filename_suffix": "acceptance"
      },
      "required_sections": [
        "criteria"
      ],
      "mints": [
        "AC",
        "AS",
        "OQ"
      ],
      "gate_blocking": true,
      "extra_frontmatter": {
        "required": [
          "verifies"
        ],
        "optional": []
      }
    },
    "decision": {
      "location": {
        "kind": "folder",
        "folder": "decisions",
        "filename_suffix": "decision"
      },
      "required_sections": [
        "context",
        "options",
        "ruling",
        "consequences"
      ],
      "mints": [
        "DEC",
        "AS",
        "OQ"
      ],
      "gate_blocking": false,
      "extra_frontmatter": {
        "required": [],
        "optional": []
      }
    },
    "glossary": {
      "location": {
        "kind": "named_file",
        "name": "glossary.md",
        "root_only": true
      },
      "required_sections": [
        "terms"
      ],
      "mints": [
        "AS",
        "OQ"
      ],
      "gate_blocking": true,
      "extra_frontmatter": {
        "required": [],
        "optional": []
      }
    },
    "actor_roster": {
      "location": {
        "kind": "named_file",
        "name": "actors.md",
        "root_only": true
      },
      "required_sections": [
        "actors"
      ],
      "mints": [
        "AS",
        "OQ"
      ],
      "gate_blocking": true,
      "extra_frontmatter": {
        "required": [],
        "optional": []
      }
    },
    "budget_set": {
      "location": {
        "kind": "named_file",
        "name": "budgets.md"
      },
      "required_sections": [
        "performance",
        "volume",
        "availability",
        "security",
        "compliance",
        "operability"
      ],
      "mints": [
        "AS",
        "OQ"
      ],
      "gate_blocking": true,
      "extra_frontmatter": {
        "required": [
          "scope"
        ],
        "optional": []
      }
    },
    "integration": {
      "location": {
        "kind": "folder",
        "folder": "integrations",
        "root_only": true,
        "filename_suffix": "integration"
      },
      "required_sections": [
        "exchange",
        "failure_semantics",
        "ownership"
      ],
      "mints": [
        "AS",
        "OQ"
      ],
      "gate_blocking": true,
      "extra_frontmatter": {
        "required": [
          "system_name",
          "direction"
        ],
        "optional": []
      }
    },
    "challenge_record": {
      "location": {
        "kind": "folder",
        "folder": "reviews",
        "filename_suffix": "review"
      },
      "required_sections": [
        "panel",
        "findings",
        "triage_audit",
        "verdict"
      ],
      "mints": [
        "CH"
      ],
      "gate_blocking": false,
      "extra_frontmatter": {
        "required": [
          "round",
          "review_scope",
          "verdict"
        ],
        "optional": [
          "locked"
        ]
      }
    }
  },
  "row_schemas": {
    "br": {
      "section": "rules",
      "columns": [
        "id",
        "statement",
        "kind",
        "status",
        "cites"
      ],
      "status_enum": [
        "active",
        "retired"
      ]
    },
    "ac": {
      "section": "criteria",
      "columns": [
        "id",
        "criterion",
        "cites",
        "verify",
        "status"
      ],
      "status_enum": [
        "active",
        "retired"
      ]
    },
    "as": {
      "section": "assumptions",
      "columns": [
        "id",
        "statement",
        "source",
        "affects",
        "status",
        "opened_on"
      ],
      "status_enum": [
        "open",
        "confirmed",
        "struck"
      ]
    },
    "oq": {
      "section": "open_questions",
      "columns": [
        "id",
        "question",
        "blocks",
        "status",
        "opened_on",
        "note"
      ],
      "status_enum": [
        "open",
        "answered",
        "deferred"
      ]
    },
    "dec": {
      "section": "ruling",
      "columns": [
        "id",
        "ruling",
        "status",
        "decided_on"
      ],
      "status_enum": [
        "active",
        "superseded"
      ]
    },
    "ch": {
      "section": "findings",
      "columns": [
        "id",
        "lens",
        "severity",
        "finding",
        "disposition",
        "targets"
      ],
      "status_enum": []
    }
  },
  "row_enums": {
    "ch_severity": [
      "blocking",
      "minor"
    ],
    "ch_disposition": [
      "covered",
      "fix",
      "assumption",
      "question",
      "rejected"
    ],
    "challenge_verdict": [
      "converged",
      "continue"
    ],
    "challenge_review_scope": [
      "domain",
      "space"
    ],
    "budget_scope": [
      "space",
      "domain"
    ],
    "integration_direction": [
      "inbound",
      "outbound",
      "bidirectional"
    ]
  },
  "challenge": {
    "max_rounds": 3,
    "round_file_format": "round-{n}-review.md",
    "space_round_file_format": "space-round-{n}-review.md"
  },
  "thresholds": {
    "nesting_warn_depth": 2,
    "nesting_fail_depth": 3,
    "node_direct_docs_warn": 12,
    "rule_sets_per_node_warn": 6,
    "active_br_per_node_warn": 60,
    "rules_per_set_warn": 15,
    "criteria_per_set_warn": 12,
    "process_doc_lines_warn": 150,
    "open_row_age_days_warn": 14,
    "space_docs_warn": 200,
    "space_bytes_warn": 1500000
  },
  "scale_profiles": [
    {"level": "small", "multiplier": 1, "nesting_bonus": 0},
    {"level": "medium", "multiplier": 3, "nesting_bonus": 1},
    {"level": "large", "multiplier": 9, "nesting_bonus": 2},
    {"level": "x-large", "multiplier": 45, "nesting_bonus": 3},
    {"level": "xx-large", "multiplier": 225, "nesting_bonus": 4},
    {"level": "enterprise", "multiplier": 1125, "nesting_bonus": 5}
  ],
  "scaled_thresholds": [
    "node_direct_docs_warn",
    "rule_sets_per_node_warn",
    "active_br_per_node_warn",
    "rules_per_set_warn",
    "criteria_per_set_warn",
    "process_doc_lines_warn",
    "space_docs_warn",
    "space_bytes_warn"
  ],
  "nesting_thresholds": [
    "nesting_warn_depth",
    "nesting_fail_depth"
  ]
}
