      "flows": [
        "design"
      ],
      "roles": [
        "ux-designer"
      ],
      "scope_kind": "design",
      "project_state": true,
      "write_scope": {
        "resolver": "unresolved",
        "roles": []
      },
      "next_transition": "Return the selected demo artifact under its existing artifact boundary; it cannot approve or replace canonical Experience sources."
