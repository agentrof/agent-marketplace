        "source": "git-subdir",
        "url": "https://github.com/agentrof/agent-marketplace.git",
        "path": "dist/codex/software-engineering-team",
        "ref": "stable"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Engineering"
    }
  ]
}
