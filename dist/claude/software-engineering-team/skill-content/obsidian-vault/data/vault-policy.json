  "retired_managed_properties": [
    "locked",
    "challenge_status",
    "challenge_hash"
  ],
  "lazy_fragments": {
    "base": ["type", "title", "status", "tags", "aliases", "derives_from", "satisfies", "constrained_by", "implements", "uses_design", "related_to"],
    "business_analysis": ["code", "scope", "round"],
    "solution_design": ["engagement", "territory", "revisit_trigger"],
    "system_architecture": ["story", "governs", "verifies"],
    "design_system": [
      "revision",
      "approved_at_utc",
      "baseline_hash",
      "supersedes_hash"
    ],
    "experience_design": [
      "program_id",
      "release_id",
      "analysis_scopes",
      "criterion_refs",
      "revision",
      "registry_hash",
      "approved_at_utc",
      "artifact_path",
      "artifact_sha256",
      "artifact_owner",
      "declared_ids"
    ],
    "backlog": [
      "goal",
      "analysis_scopes",
      "priority",
      "priority_reason",
      "work_kind",
      "issue_kind",
      "external_url",
      "filed_at_utc",
      "source_hash",
      "supporting_roles",
      "depends_on",
      "dependency_refs",
      "experience_refs",
      "package_hash",
      "scenario_refs",
      "release_id",
      "criterion_refs",
      "revision",
      "approved_at_utc"
    ]
  },
  "fragment_graph_groups": {
    "base": ["navigation"],
    "business_analysis": ["space", "domain", "glossary", "actor-roster", "budget-set", "entity", "process", "rule-set", "acceptance-set", "decision", "integration"],
    "solution_design": ["landscape", "engagement", "decision"],
    "system_architecture": ["decision", "system-living"],
    "design_system": ["design-master", "page-override"],
    "experience_design": ["experience", "journey", "screen"],
    "backlog": ["backlog", "backlog-review", "epic", "epic-review", "story", "test-plan", "issue-report"]
  },
  "extra_doc_types": [
    "moc",
    "home",
    "landscape",
    "engagement",
    "design-master",
    "page-override",
    "experience",
    "program",
    "release",
    "journey",
    "flow-set",
    "screen",
    "experience-space",
    "experience-domain",
    "api-contract",
    "data-model",
    "threat-model",
    "environment-reference",
    "artifact-manifest",
    "backlog",
    "backlog-review",
    "epic",
    "epic-review",
    "story",
    "test-plan",
    "issue-report"
  ],
  "default_designations": {
    "backlog": "backlog",
    "backlog_review": "backlog review",
    "epic": "epic",
    "epic_review": "epic review",
    "story": "story",
    "test_plan": "test plan",
    "issue_report": "issue report"
  },
  "type_path_patterns": {
    "home": ["^home\\.md$"],
    "moc": ["^maps/[a-z0-9-]+\\.md$", "^maps/_relations/[a-f0-9]{12}/relations-[0-9]{3}\\.md$"],
    "landscape": ["^solution-design/landscape\\.md$"],
    "engagement": ["^solution-design/engagements/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"],
    "design_master": ["^design-system/MASTER\\.md$"],
    "page_override": ["^design-system/pages/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"],
    "experience": ["^experience-design/experience\\.md$"],
    "program": ["^experience-design/programs/prg-[0-9]+/program\\.md$"],
    "release": ["^experience-design/programs/prg-[0-9]+/releases/rel-[0-9]+/release\\.md$"],
    "experience_space": ["^experience-design/programs/prg-[0-9]+/releases/rel-[0-9]+/spaces/[a-z0-9]+(?:-[a-z0-9]+)*/space\\.md$"],
    "experience_domain": ["^experience-design/programs/prg-[0-9]+/releases/rel-[0-9]+/spaces/[a-z0-9]+(?:-[a-z0-9]+)*/(?:domains/[a-z0-9]+(?:-[a-z0-9]+)*/)+domain\\.md$"],
    "journey": ["^experience-design/programs/prg-[0-9]+/releases/rel-[0-9]+/(?:spaces/[a-z0-9-]+/(?:domains/[a-z0-9-]+/)*)?journeys/[a-z0-9]+(?:-[a-z0-9]+)*-journey\\.md$"],
    "flow_set": ["^experience-design/programs/prg-[0-9]+/releases/rel-[0-9]+/(?:spaces/[a-z0-9-]+/(?:domains/[a-z0-9-]+/)*)?flows/[a-z0-9]+(?:-[a-z0-9]+)*-flows\\.md$"],
    "screen": ["^experience-design/programs/prg-[0-9]+/releases/rel-[0-9]+/(?:spaces/[a-z0-9-]+/(?:domains/[a-z0-9-]+/)*)?screens/[a-z0-9]+(?:-[a-z0-9]+)*-screen\\.md$"],
    "artifact_manifest": ["^experience-design/programs/prg-[0-9]+/releases/rel-[0-9]+/(?:.+/)?artifacts/[a-z0-9]+(?:-[a-z0-9]+)*-artifact\\.md$"],
    "api_contract": ["^system-architecture/api-contract\\.md$"],
    "data_model": ["^system-architecture/data-model\\.md$"],
    "threat_model": ["^system-architecture/threat-model\\.md$"],
    "environment_reference": ["^system-architecture/environment\\.md$"],
    "decision": ["^(?:solution-design|system-architecture)/decisions/[a-z0-9]+(?:-[a-z0-9]+)*-decision\\.md$", "^business-analysis/.+/decisions/[a-z0-9]+(?:-[a-z0-9]+)*-decision\\.md$"],
    "backlog": ["^backlog/backlog\\.md$"],
    "backlog_review": ["^backlog/reviews/round-[0-9]+-backlog-review\\.md$"],
    "epic": ["^backlog/epics/[a-z0-9]+(?:-[a-z0-9]+)*/epic\\.md$"],
    "epic_review": ["^backlog/epics/[a-z0-9]+(?:-[a-z0-9]+)*/reviews/round-[0-9]+-epic-review\\.md$"],
    "story": ["^backlog/epics/[a-z0-9]+(?:-[a-z0-9]+)*/stories/[a-z0-9]+(?:-[a-z0-9]+)*/story\\.md$"],
    "test_plan": ["^backlog/epics/[a-z0-9]+(?:-[a-z0-9]+)*/stories/[a-z0-9]+(?:-[a-z0-9]+)*/test-plan\\.md$"],
    "issue_report": ["^issues/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"]
  },
  "status_values": {
    "decision": ["draft", "proposed", "accepted", "rejected", "approved", "superseded"],
    "landscape": ["draft", "in_review", "approved", "superseded"],
    "experience": ["draft", "in_review", "approved", "retired"],
    "program": ["draft", "in_review", "approved", "retired"],
    "release": ["draft", "in_review", "approved", "retired"],
    "experience_space": ["draft", "in_review", "approved", "retired"],
    "experience_domain": ["draft", "in_review", "approved", "retired"],
    "journey": ["draft", "in_review", "approved", "retired"],
    "flow_set": ["draft", "in_review", "approved", "retired"],
    "screen": ["draft", "in_review", "approved", "retired"],
    "artifact_manifest": ["approved", "retired"],
    "api_contract": ["draft", "in_review", "approved", "retired"],
    "data_model": ["draft", "in_review", "approved", "retired"],
    "threat_model": ["draft", "in_review", "approved", "retired"],
    "environment_reference": ["draft", "in_review", "approved", "retired"],
    "backlog": ["draft", "approved", "superseded"],
    "backlog_review": ["draft", "changes_requested", "approved"],
    "epic": ["draft", "approved", "superseded"],
    "epic_review": ["draft", "changes_requested", "approved"],
    "story": ["planned"],
    "test_plan": ["draft", "approved", "superseded", "retired"],
    "issue_report": ["draft", "approved", "filed"]
  },
  "backlog_contract": {
    "story_owner_roles": [
      "backend_developer",
      "frontend_developer",
      "devops_engineer"
    ],
    "story_supporting_roles": [
      "backend_developer",
      "frontend_developer",
      "devops_engineer",
      "software_architect",
      "ux_designer"
    ],
    "required_story_sections": [
      "User Value",
      "Scope",
      "Non-Goals",
      "Implementation Responsibilities",
      "Acceptance",
      "Dependencies",
      "Delivery Notes"
    ],
    "required_epic_review_sections": [
      "Scope",
      "Slicing",
      "Criteria Coverage",
      "Test Design",
      "Dependencies",
      "Role Ownership",
      "Findings",
      "Verdict"
    ],
    "required_backlog_review_sections": [
      "Epic Coverage",
      "Cross-Epic Overlap",
      "Cross-Epic Dependencies",
      "Release Ordering",
      "Shared Contracts",
      "Deferred Criteria",
      "Global Test Coverage",
      "Findings",
      "Verdict"
    ],
    "experience_ref_types": [
      "release",
      "journey",
      "flow-set",
      "screen",
      "experience-space",
      "experience-domain"
    ]
  },
  "relation_contract": {
    "inverse_inline_max": 100,
    "catalog_page_size": 100,
    "catalog_root": "maps/_relations",
    "keys": {
      "derives_from": {"targets": ["*"], "inverse_label": "Derived knowledge"},
      "satisfies": {"targets": ["acceptance-set", "rule-set", "budget-set"], "inverse_label": "Satisfied by"},
      "constrained_by": {"targets": ["budget-set", "decision", "landscape", "design-master", "page-override", "api-contract", "data-model", "threat-model", "environment-reference"], "inverse_label": "Constrains"},
      "implements": {"targets": ["landscape", "decision", "journey", "flow-set", "screen", "api-contract", "data-model", "threat-model", "environment-reference"], "inverse_label": "Implemented by"},
      "uses_design": {"targets": ["design-master", "page-override"], "inverse_label": "Used by"},
      "related_to": {"targets": ["*"], "inverse_label": "Related from"},
      "verifies": {"targets": ["process", "story", "acceptance-set", "rule-set", "test-plan"], "inverse_label": "Verified by"}
    },
    "required_by_type_status": {
      "landscape": {"approved": ["derives_from"]},
      "page_override": {"all_statuses": ["uses_design"]},
      "program": {"approved": ["derives_from", "constrained_by"]},
      "release": {"approved": ["derives_from", "constrained_by"]},
      "journey": {"approved": ["derives_from", "satisfies"]},
      "flow_set": {"approved": ["derives_from", "satisfies"]},
      "screen": {"all_statuses": ["derives_from", "uses_design"], "approved": ["satisfies"]}
    },
    "cardinality_by_type": {
      "experience_space": {"derives_from": {"min": 1, "max": 1}},
      "experience_domain": {"derives_from": {"min": 1, "max": 1}},
      "page_override": {"uses_design": {"min": 1, "max": 1}},
      "screen": {"uses_design": {"min": 1, "max": 1}},
      "artifact_manifest": {"related_to": {"min": 1, "max": 1}},
      "backlog_review": {"derives_from": {"min": 1, "max": 1}},
      "epic_review": {"derives_from": {"min": 1, "max": 1}},
      "story": {"derives_from": {"min": 1, "max": 20}},
      "test_plan": {"derives_from": {"min": 1, "max": 1}, "verifies": {"min": 1, "max": 100}}
    }
  }
}
